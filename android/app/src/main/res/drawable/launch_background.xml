<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة البداية الأصلية — تدرج الهوية والصاعقة في النص.
     بتفضل ظاهرة لحد ما فلاتر يشتغل، فلازم تطابق SplashScreen في الدارت. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#12399B"
                android:endColor="#602D90"
                android:angle="315" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_bolt"
            android:alpha="0.16" />
    </item>
</layer-list>
